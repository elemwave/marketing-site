{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "shape": "node scripts/check-shape-lint.mjs",
    "shape:report": "node scripts/check-shape-lint.mjs --report",
    "shape:update": "node scripts/check-shape-lint.mjs --update",
    "e2e": "playwright test",
    "start:export": "node scripts/write-serve-headers.mjs && serve out --listen 3000 --config serve.json --no-clipboard",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../tools/coverage-files-gate/run.js --summary ../../coverage/coverage-summary.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-calendly": "^4.4.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-sonarjs": "4.2.1",
    "jsdom": "30.0.1",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "edge >= 111"
  ]
}
